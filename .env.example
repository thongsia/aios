# AIOS configuration
#
# Copy the settings you need into ~/.hermes/.env and fill them in. The Hermes
# gateway and the aios scripts (kakis/scripts/*.py) both read that file.
# Keep this the only place host addresses and credentials live; never commit real values.

# OpenSearch mirror (see README, "OpenSearch memory mirror"). Required for
# mirroring Kakis runs; if unset, the scripts exit with a clear not-configured
# message and mirroring is skipped (runs continue normally).
#AIOS_OPENSEARCH=http://<your-opensearch-host>:9200

# Root for Kakis run workspaces (optional; default: ~/.hermes/kakis-runs)
#KAKIS_RUNS_ROOT=

# Telegram (required for Kakis gates and notifications; read by the Hermes
# gateway and kakis/scripts/gate.py)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_HOME_CHANNEL=
